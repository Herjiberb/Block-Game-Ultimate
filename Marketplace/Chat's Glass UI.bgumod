{
  "name": "Glassmorphic UI Revamp",
  "version": "1.0.0",
  "author": "Generated by ChatGPT",
  "css": "\n/* Glassmorphic UI Revamp for Block Game Ultimate\n   This CSS is designed to be injected by the game's mod system and to\n   replace the default UI with a frosted glass / blurred translucent theme.\n   It uses strong selectors and !important to ensure it overrides the defaults.\n*/\n\n/* Theme variables */\n:root{\n  --glass-bg: rgba(255,255,255,0.06);\n  --glass-bg-strong: rgba(255,255,255,0.10);\n  --glass-border: rgba(255,255,255,0.18);\n  --accent: rgba(170,200,255,0.95);\n  --accent-2: rgba(120,160,255,0.95);\n  --muted: rgba(255,255,255,0.7);\n  --shadow: 0 8px 30px rgba(10,20,40,0.45);\n  --glass-radius: 14px;\n  --glass-padding: 10px;\n  --glass-blur: 10px;\n  --font-sans: \"Inter\", \"Segoe UI\", Roboto, system-ui, -apple-system, \"Helvetica Neue\", Arial;\n}\n\n/* Reset & body */\nbody, html {\n  background: linear-gradient(180deg, rgba(18,25,35,1) 0%, rgba(12,18,26,1) 100%) !important;\n  color: var(--muted) !important;\n  font-family: var(--font-sans) !important;\n  -webkit-font-smoothing: antialiased !important;\n  -moz-osx-font-smoothing: grayscale !important;\n  height: 100% !important;\n  margin: 0 !important;\n  overflow: hidden !important;\n}\n\n/* Game container and canvas lift */\n#gameContainer {\n  position: relative !important;\n  width: 100vw !important;\n  height: 100vh !important;\n  display: block !important;\n  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.00)) !important;\n  -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.05) !important;\n  backdrop-filter: blur(var(--glass-blur)) saturate(1.05) !important;\n}\n\n/* Canvas visual - keep pixel rendering but framed softly */\ncanvas#gameCanvas {\n  display: block !important;\n  width: 100% !important;\n  height: 100% !important;\n  border-radius: 8px !important;\n  box-shadow: var(--shadow) !important;\n  border: 1px solid rgba(255,255,255,0.04) !important;\n  background-clip: padding-box !important;\n}\n\n/* Global frosted panels */\n[class$=\"Overlay\"], .menu, #gameMenu, #inventoryCraftingMenu, #chestMenu, #voidChestMenu,\n#anvilMenu, #bookEditor, #publishMenu, #bookReaderMenu, #ovenMenu, #devConsole {\n  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.03)) !important;\n  border: 1px solid var(--glass-border) !important;\n  border-radius: var(--glass-radius) !important;\n  padding: var(--glass-padding) !important;\n  box-shadow: var(--shadow) !important;\n  color: var(--muted) !important;\n  -webkit-backdrop-filter: blur(calc(var(--glass-blur) * 0.8)) saturate(1.05) !important;\n  backdrop-filter: blur(calc(var(--glass-blur) * 0.8)) saturate(1.05) !important;\n}\n\n/* Make dark overlays slightly stronger */\n#gameMenuOverlay, #inventoryCraftingOverlay, #chestOverlay, #voidChestOverlay, #anvilOverlay,\n#bookMenuOverlay, #publishMenuOverlay, #bookReaderOverlay, #ovenOverlay, #xpMenuOverlay,\n#customMessageBoxOverlay, #devConsoleOverlay, #seasonalShopOverlay {\n  background: linear-gradient(180deg, rgba(6,8,12,0.62), rgba(8,10,14,0.8)) !important;\n  border: 1px solid rgba(255,255,255,0.04) !important;\n}\n\n/* Headings */\n#gameMenu h2, #ovenMenu h2, #bookEditor h2, #xpMenu h2, #traderLevelUpMenu h2 {\n  color: var(--accent) !important;\n  font-weight: 700 !important;\n  letter-spacing: 0.6px !important;\n  text-shadow: 0 3px 18px rgba(80,110,200,0.06) !important;\n}\n\n/* Buttons */\nbutton, .menu-buttons button, #skinUploadLabel, #bookImportLabel, .upgrade-button, .shop-buy-btn {\n  background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02)) !important;\n  border: 1px solid rgba(255,255,255,0.06) !important;\n  color: var(--muted) !important;\n  padding: 10px 14px !important;\n  border-radius: 10px !important;\n  box-shadow: 0 6px 18px rgba(12,18,28,0.5) !important;\n  cursor: pointer !important;\n  transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease !important;\n  font-weight: 600 !important;\n}\n\n/* Accent buttons */\n#resumeButton, #newGameButton, #craftButton, #cookButton, #bookPublishButton,\n#traderAcceptButton, #seasonalShopButton, .shop-buy-btn {\n  background: linear-gradient(90deg, var(--accent-2), var(--accent)) !important;\n  color: rgba(6,8,12,0.98) !important;\n  border: none !important;\n  box-shadow: 0 8px 26px rgba(70,110,255,0.12) !important;\n}\n\n/* Button hover */\nbutton:hover, .menu-buttons button:hover {\n  transform: translateY(-3px) !important;\n  box-shadow: 0 12px 34px rgba(12,18,28,0.6) !important;\n}\n\n/* Hotbar - glass strip */\n#hotbar {\n  position: absolute !important;\n  bottom: 18px !important;\n  left: 50% !important;\n  transform: translateX(-50%) !important;\n  display: flex !important;\n  gap: 10px !important;\n  padding: 8px !important;\n  border-radius: 999px !important;\n  background: linear-gradient(90deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02)) !important;\n  border: 1px solid rgba(255,255,255,0.06) !important;\n  box-shadow: 0 10px 30px rgba(6,8,12,0.55) !important;\n  z-index: 60 !important;\n  backdrop-filter: blur(6px) !important;\n}\n\n/* Hotbar slots */\n.hotbar-slot {\n  width: 48px !important;\n  height: 48px !important;\n  border-radius: 8px !important;\n  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(0,0,0,0.04)) !important;\n  border: 1px solid rgba(255,255,255,0.06) !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  box-shadow: inset 0 -6px 14px rgba(0,0,0,0.35), 0 6px 18px rgba(2,4,8,0.5) !important;\n  transition: transform 0.08s ease !important;\n}\n\n/* Selected slot */\n.hotbar-slot.selected {\n  transform: translateY(-6px) !important;\n  box-shadow: 0 18px 36px rgba(30,80,200,0.12) !important;\n  border: 1px solid rgba(170,200,255,0.9) !important;\n}\n\n/* Item counts and images */\n.hotbar-slot span, .inventory-slot .item-count {\n  color: rgba(255,255,255,0.95) !important;\n  text-shadow: 0 2px 6px rgba(0,0,0,0.7) !important;\n  font-weight: 700 !important;\n  font-size: 12px !important;\n}\n\n/* Inventory grid panels */\n.inventory-grid, .recipe-input-grid, #craftingGrid, #ovenGrid, .inventory-section {\n  background: linear-gradient(180deg, rgba(10,12,16,0.40), rgba(10,12,16,0.30)) !important;\n  border-radius: 12px !important;\n  padding: 8px !important;\n  border: 1px solid rgba(255,255,255,0.03) !important;\n}\n\n/* Inventory slots */\n.inventory-slot, .recipe-output .inventory-slot, .recipe-input-grid .inventory-slot, .achievement-slot {\n  width: 52px !important;\n  height: 52px !important;\n  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.06)) !important;\n  border: 1px solid rgba(255,255,255,0.04) !important;\n  border-radius: 10px !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  box-shadow: inset 0 -6px 10px rgba(0,0,0,0.45) !important;\n}\n\n/* Tooltip */\n#itemTooltip, .achievement-slot .tooltiptext {\n  background: linear-gradient(180deg, rgba(6,8,12,0.9), rgba(6,8,12,0.82)) !important;\n  border: 1px solid rgba(255,255,255,0.04) !important;\n  padding: 8px 10px !important;\n  border-radius: 8px !important;\n  color: var(--muted) !important;\n  box-shadow: 0 6px 22px rgba(0,0,0,0.6) !important;\n}\n\n/* Health bar */\n#healthBar {\n  position: absolute !important;\n  top: 18px !important;\n  left: 18px !important;\n  display: flex !important;\n  gap: 6px !important;\n  z-index: 70 !important;\n  align-items: center !important;\n  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(8,12,18,0.02)) !important;\n  padding: 6px !important;\n  border-radius: 12px !important;\n  border: 1px solid rgba(255,255,255,0.04) !important;\n  backdrop-filter: blur(6px) !important;\n}\n\n/* Debug and coords */\n#coordsDisplay, #debugStats, #hellfireContainer, #minimapContainer {\n  background: linear-gradient(180deg, rgba(8,10,14,0.6), rgba(8,10,14,0.48)) !important;\n  border: 1px solid rgba(255,255,255,0.03) !important;\n  color: var(--muted) !important;\n  padding: 8px !important;\n  border-radius: 10px !important;\n  box-shadow: 0 8px 24px rgba(8,10,16,0.6) !important;\n}\n\n/* Loading screen centered glass */\n#loadingScreen {\n  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02)) !important;\n  border: 1px solid rgba(255,255,255,0.06) !important;\n  padding: 18px !important;\n  border-radius: 12px !important;\n  box-shadow: 0 14px 48px rgba(2,6,12,0.7) !important;\n}\n\n/* Toasts */\n.achievement-toast {\n  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)) !important;\n  border: 1px solid rgba(255,255,255,0.04) !important;\n  color: var(--muted) !important;\n}\n\n/* Mobile controls softened */\n#joystickContainer, .mobile-button {\n  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)) !important;\n  border-radius: 18px !important;\n  border: 1px solid rgba(255,255,255,0.03) !important;\n  backdrop-filter: blur(4px) !important;\n}\n\n/* Console & dev area */\n#devConsole {\n  background: linear-gradient(180deg, rgba(6,8,12,0.86), rgba(6,8,12,0.94)) !important;\n  border-radius: 12px !important;\n  border: 1px solid rgba(255,255,255,0.03) !important;\n}\n\n/* Small helpers */\n.hidden, .invisible { display:none !important; }\n\n/* Make sure z-indexes for UI are high so they sit above canvas visuals */\n#hotbar, #healthBar, #coordsDisplay, #debugStats, #minimapContainer, #achievementToastContainer {\n  z-index: 9999 !important;\n}\n\n/* Accessibility: focus outlines */\nbutton:focus, .hotbar-slot:focus, .inventory-slot:focus {\n  outline: 2px solid rgba(170,200,255,0.25) !important;\n  outline-offset: 2px !important;\n}\n\n/* Final safety: ensure text remains readable on dark backgrounds */\n* { color-adjust: exact; -webkit-print-color-adjust: exact; }\n"
}